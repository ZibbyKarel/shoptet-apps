{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@garage/contract": ["./libs/garage/contract/src/index.ts"],
      "@garage/contract/realtime": ["./libs/garage/contract/src/realtime/index.ts"],
      "@garage/design-system/compounds": ["./libs/shared/design-system/src/compounds/index.ts"],
      "@garage/design-system/primitives": ["./libs/shared/design-system/src/primitives/index.ts"],
      "@garage/design-system/tokens": ["./libs/shared/design-system/src/tokens/index.ts"],
      "@garage/shared-types": ["./libs/garage/shared-types/src/index.ts"],
      "@garage/calendar-export": ["./libs/garage/calendar-export/src/index.ts"],
      "@garage/database": ["./libs/garage/database/src/index.ts"],
      "@garage/i18n": ["./libs/shared/i18n/src/index.ts"],
      "@garage/form": ["./libs/shared/form/src/index.ts"],
      "@garage/api-client": ["./libs/shared/api-client/src/index.ts"],
      "@garage/auth": ["./libs/garage/auth/src/index.ts"],
      "@garage/auth/client": ["./libs/garage/auth/src/client/index.ts"],
      "@garage/realtime-client": ["./libs/garage/realtime-client/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
