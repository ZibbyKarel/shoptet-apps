# Garage — example environment variables.
#
# Copy this file to `.env` at the repo root (used by `docker compose` and by
# `apps/garage/api` when run via `nx serve api`, whose working directory is the
# repo root). `apps/garage/web` loads its own env files from `apps/garage/web/` (Next.js
# resolves them relative to its own directory, not the repo root) — for
# local dev without Docker, also copy this file to `apps/garage/web/.env` (or
# symlink it). See `doc/environment.md` for the full explanation and exact
# commands.
#
# Every value below is an obviously-fake dev value pointing at the local
# `mock-oauth2-server` and `postgres` containers started by
# `docker-compose.yml`. NEVER put a real secret in this file — this file is
# committed to the repo. Real secrets only ever come from the environment
# (a real `.env`, which is git-ignored, or the deployment platform's secret
# store).
#
# Dev, e2e and production all run the exact same code path; only these
# values differ between them (see `doc/environment.md`).

# --- apps/garage/api (validated by apps/garage/api/src/env.ts) ----------------------------

NODE_ENV=development

# Port the NestJS HTTP server listens on.
PORT=3000

# Postgres connection string. Must match POSTGRES_USER/PASSWORD/DB below —
# docker-compose configures the `postgres` container from those, this is
# what the API actually connects with.
DATABASE_URL=postgresql://garage:garage_dev_password@localhost:5432/garage

# OIDC issuer the API trusts to validate incoming JWTs (JWKS discovered from
# `${AUTH_OKTA_ISSUER}/.well-known/openid-configuration`). In dev/e2e this is
# the mock-oauth2-server container's default issuer, "default" — in
# production it would be the real Okta org's issuer URL. Same value, same
# validation code, no test-only branch anywhere (see doc/decision/0008-*).
# Shared with apps/garage/web below — both validate against the same issuer.
AUTH_OKTA_ISSUER=http://localhost:8080/default

# Expected `aud` claim on incoming JWTs.
#
# `default`, not `api://default`, and this is the dev/e2e value specifically.
# mock-oauth2-server is started with no JSON_CONFIG, so its default token
# callback decides the audience as:
#
#   configured audience (none) -> `audience` request parameter (libs/garage/auth sends
#   none) -> the token request's non-OIDC scopes (Auth.js v5 sends no scope on
#   the token request, and the refresh POST sends only grant_type +
#   refresh_token) -> else listOf("default")
#
# so it mints `aud: ["default"]`. Setting `api://default` here would let sign-in
# succeed and then 401 every API call and Socket.io handshake with
# "jwt audience invalid".
#
# In production this is the Custom Authorization Server's audience — typically
# `api://default`. That is an env value, not a code path: apps/garage/api compares this
# variable against the token either way. See doc/auth.md, "The audience the two
# halves agree on".
AUTH_OKTA_AUDIENCE=default

# Comma-separated list of origins the API's CORS allow-list accepts. No
# wildcard — every origin must be an absolute URL.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# nestjs-pino log level: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# --- Realtime (Task 15, apps/garage/api) -------------------------------------------

# How long a cell's editing hold lasts before it lapses, in milliseconds.
# Optional; the default shown is the production value. Not a free number —
# libs/garage/realtime-client renews at half the remaining time and gives a renewal two
# 5 s attempts, so a TTL much below ~15 s would leave the client giving up after
# the hold had already lapsed. See doc/decision/0110-* and doc/environment.md.
# REALTIME_LOCK_TTL_MS=30000

# --- Slack notifications (Task 16, apps/garage/api) --------------------------------
#
# All optional: leaving this whole block out is a valid configuration and is
# what production installations that want no Slack should do.
#
# SLACK_ENABLED is `false` here and that is deliberate — it is the *only*
# thing standing between a developer's laptop and a real workspace, and there
# is no `NODE_ENV` branch or "pretend to send" flag behind it (there is no
# test-only branch anywhere in this project; see doc/decision/0130-*). With it
# off, every notification still builds its message and reads its data; the
# call simply stops at the one gate in `SlackClient`.
#
# To try it against a real workspace, set it to `true` and supply the two
# variables below — the API then refuses to boot without them. Only `true` and
# `false` parse; `1`, `yes` and an empty value are rejected by name.
SLACK_ENABLED=false

# Bot token (`xoxb-…`) with `chat:write` and `users:read.email`. NEVER commit a
# real one; this file is in the repo. `SlackClient` redacts it out of the one
# failure-message field it logs (apps/garage/api/src/slack/slack-token-redaction.ts) —
# that is not a blanket guarantee over every log line the API writes; nothing
# redacts a raw `err` logged elsewhere (e.g. ScheduledJobRunner's or
# SlackDomainEventPublisher's own failure logging), so keep the token out of
# anything that could end up there too.
# SLACK_BOT_TOKEN=xoxb-replace-me

# Channel the freed-spot notice and the daily summary are posted to. The bot
# must be a member of it, or Slack answers `not_in_channel`.
# SLACK_CHANNEL_ID=C0123456789

# Per-attempt HTTP timeout, total attempts (the first included), and the first
# backoff delay — which doubles for each further attempt. Defaults shown.
# SLACK_REQUEST_TIMEOUT_MS=5000
# SLACK_RETRY_ATTEMPTS=3
# SLACK_RETRY_BASE_DELAY_MS=500

# When the daily summary is posted, `HH:MM` **in Europe/Prague** (not UTC, and
# not a duration — it stays 08:00 local across both DST changes). The job runs
# every day and skips weekends and Czech public holidays by itself.
# SLACK_DAILY_SUMMARY_AT=08:00

# --- apps/garage/web (validated by apps/garage/web/src/env.ts) ----------------------------

# NODE_ENV is also read by apps/garage/web; Next.js sets it automatically for
# `next dev`/`next build`/`next start`, but it is listed here too because our
# schema requires it explicitly (see apps/garage/web/src/env.ts).
# NODE_ENV=development

# Base URL the web app calls the API at. Includes the API's global prefix.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Auth.js session cookie signing/encryption secret. Must be at least 32
# characters. This placeholder is long enough to pass validation but is NOT
# a real secret — generate your own with `openssl rand -hex 32` before this
# ever needs to be a real deployment.
AUTH_SECRET=dev-secret-please-regenerate-with-opensslrandhex32-not-real

# AUTH_OKTA_ISSUER is shared with apps/garage/api above (same variable name, same
# value) — Auth.js here and the API's JWT validation both point at the same
# OIDC issuer. It is the only Okta URL in this file on purpose: libs/garage/auth
# discovers the token endpoint it refreshes against from
# `${AUTH_OKTA_ISSUER}/.well-known/openid-configuration`, the same document
# the API reads its JWKS URI from (doc/decision/0045-*).

# OAuth2 client registered for the web app. mock-oauth2-server accepts any
# client_id/secret by default, so these fake values work out of the box.
AUTH_OKTA_CLIENT_ID=garage-web-dev
AUTH_OKTA_CLIENT_SECRET=garage-web-dev-secret

# --- docker-compose (infrastructure only — not read by either app) ---------

# Credentials docker-compose gives the `postgres` container. Keep these in
# sync with the embedded credentials in DATABASE_URL above by hand — the two
# are not derived from each other.
POSTGRES_USER=garage
POSTGRES_PASSWORD=garage_dev_password
POSTGRES_DB=garage
